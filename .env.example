# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL, no trailing slash. Used for metadata, sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fan Zone (Phase 6). All four are server only: never prefix them with NEXT_PUBLIC_.
# Set the same four names in Vercel (Project Settings, Environment Variables).
# Leave them all unset and the Fan Zone shows "not connected" while the quiz still plays.

# Supabase project URL, for example https://abcdefgh.supabase.co
SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key. Read-only; RLS limits it.
SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or the legacy service_role key. Bypasses RLS. Never share it.
SUPABASE_SERVICE_ROLE_KEY=
# Random string of 32 or more characters. Hashes browser ids and IP addresses.
FAN_ZONE_HASH_SECRET=
