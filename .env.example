# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL, no trailing slash. Used for metadata, sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 6). Safe to expose: URL and anon/publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret (service role / secret key). Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Random 32+ character string. Hashes voter ids and IPs. Server only.
FAN_ZONE_HASH_SECRET=
